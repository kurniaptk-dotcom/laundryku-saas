# LAUNDRYKU PRO - SUPABASE ENVIRONMENT VARIABLES
# Paste your Supabase API credentials below (from Supabase Dashboard > Project Settings > API)

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Never enable this in a shared or production project. It only permits the
# browser client to insert demo tenant records during local development.
VITE_ENABLE_DEMO_SEED=false
